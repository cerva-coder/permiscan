rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // firebase-rule-public (critical): leitura e escrita abertas a todos.
    match /public_dump/{doc} {
      allow read, write: if true;
    }

    // firebase-rule-public (high): leitura pública.
    match /articles/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // firebase-rule-any-authenticated-write (medium): qualquer logado escreve.
    match /orders/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if request.auth != null;
    }
  }
}
